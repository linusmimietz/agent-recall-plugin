# Copy to .env and fill in. Never commit the real values.
# Keys are region-scoped: a key from the wrong region returns 401.
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Optional — display name shown to meeting participants.
RECALL_BOT_NAME=Agent Notetaker
# Optional — where transcripts are written.
# Default: ~/.agent/workspace/recall/<bot_id>/
RECALL_OUTPUT_DIR=
